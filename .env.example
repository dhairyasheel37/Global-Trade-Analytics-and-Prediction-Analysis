# ==============================================================================
# Global Trade Analytics & Predictive Intelligence Platform
# Production Environment Configuration Template
# ==============================================================================

# Application & Database Paths
DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/data/trade_data.db

# Authentication & Security
# (Change to a unique random string in production environments)
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Automated Briefings & SMTP Email Dispatch Configuration
# (Optional: Leave empty if testing without real email dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=briefings@globaltrade.analytics
SMTP_USE_TLS=true

# Exposed Ports (Host Machine)
BACKEND_PORT=8000
FRONTEND_PORT=80
